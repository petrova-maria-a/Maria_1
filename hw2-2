num = int(input('Вводите целые числа \n'))
while num != 0:
    if (num % 10 == 0) or ((num % 10 > 4) and (num % 10 <= 9)) or ((num > 10) and (num < 20 )):
        print(f'{num} кроликов')
    elif ((num % 10 >= 2) and (num % 10 <= 4)):
        print(f'{num} кролика')
    elif (num % 10 == 1):
        print (f'{num} кролик')
    num = int(input('Вводите целые числа \n'))


