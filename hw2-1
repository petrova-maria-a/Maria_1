num = float(input('Вводите числа \n'))
sum = 0
srednee = 0
count = 0
otklon = 0
while num != 0:
    sum += num
    count = count + 1
    srednee = sum / count
    otklon = ((1 / count) * sum * (num - srednee)) ** (1/2)
    num = input()
    num = float(num)

print(f'сумма = {sum}, среднее = {srednee}, отклонение = {otklon}')